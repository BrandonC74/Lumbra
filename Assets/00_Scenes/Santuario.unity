  m_EditorClassIdentifier: Assembly-CSharp::Boss
  startX: 246
  floorY: 9
  timeBtwClaws: 2.6
  timeBtwSpawns: 7
  maxShadows: 3
  timeBtwDevours: 20
  voiceSpanish: {fileID: 8300000, guid: 924ad97243da3d340a6ec10876c6e43f, type: 3}
  voiceEnglish: {fileID: 8300000, guid: d343eb998e458ea43822a83121f03bd2, type: 3}
  introLines:
  - speaker: ???
    text: Gracias, Lumbra... me trajiste sus almas.
    textEn: Thank you, Lumbra... you brought me their souls.
  - speaker: El Devorador
    text: La voz que te guiaba... siempre fui yo.
    textEn: The voice that guided you... it was always me.
  - speaker: 
    text: "Lleva las almas a los cuatro braseros: ac\xE9rcate y pulsa F."
    textEn: 'Bring the souls to the four braziers: get close and press F.'
  defeatLines:
  - speaker: El Devorador
    text: No... la luz... otra vez...
    textEn: No... the light... again...
  - speaker: 
    text: "El portal se abri\xF3."
    textEn: The portal has opened.
